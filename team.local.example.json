{
  "capacity": {
    "minAvailGb": 8,
    "stopAvailGb": 6,
    "maxLoad5": 12,
    "stopDiskPct": 85
  },
  "boardUrl": "",
  "hosts": [
    {
      "name": "pc2",
      "ssh": "pc2",
      "path": "~/workspace",
      "use": [
        "exec",
        "worker"
      ]
    }
  ],
  "schedule": {
    "enabled": false,
    "allowedTools": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Agent",
      "Bash(.team/tools/capacity-check.sh)",
      "Bash(.team/tools/ticket.py:*)",
      "Bash(.team/tools/journal-archive.sh:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(.team/tools/gitlab-pipelines.py:*)"
    ]
  }
}
