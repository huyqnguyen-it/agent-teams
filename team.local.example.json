{
  "capacity": {
    "minAvailGb": 8,
    "stopAvailGb": 6,
    "maxLoad5": 12,
    "stopDiskPct": 85,
    "maxAgents": 4,
    "perAgentGb": 2,
    "perAgentLoad": 1,
    "heavyGb": 4,
    "heavyLoad": 2
  },
  "boardUrl": "",
  "hosts": [
    {
      "name": "pc2",
      "ssh": "pc2",
      "path": "~/workspace",
      "use": [
        "exec",
        "worker"
      ],
      "maxAgents": 3,
      "cli": "claude"
    }
  ],
  "worker": {
    "cli": "claude",
    "cmd": "",
    "model": "sonnet",
    "maxTurns": 40,
    "maxBudgetUsd": 2,
    "timeoutMin": 20,
    "allowedTools": [
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(date:*)"
    ]
  },
  "schedule": {
    "enabled": false,
    "allowedTools": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Agent",
      "Bash(.team/tools/capacity-check.sh)",
      "Bash(.team/tools/ticket.py:*)",
      "Bash(.team/tools/journal-archive.sh:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(.team/tools/gitlab-pipelines.py:*)",
      "Bash(.team/tools/resource-lease.py:*)"
    ],
    "maxTurns": 60,
    "maxBudgetUsd": 3,
    "timeoutMin": 25
  }
}
